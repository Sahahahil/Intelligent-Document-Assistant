# Copy to .env and fill in the blanks. Never commit .env.

APP_NAME=Intelligent Document Assistant
DEBUG=false

# PostgreSQL — documents and bookings
DATABASE_URL=postgresql+asyncpg://document_db:document_db@localhost:5432/document_db

# Redis — conversation memory
REDIS_URL=redis://localhost:6379/0

# Qdrant — vector store.
# Leave QDRANT_URL empty to run Qdrant embedded on disk (QDRANT_PATH): no server needed.
# Set QDRANT_URL to a server URL (http://localhost:6333) to use one instead.
QDRANT_URL=
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=documents

# LLM — any OpenAI-compatible provider (OpenAI, Gemini compat, Groq, local vLLM)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Embeddings — 384 dimensions, truncates at 256 word-pieces
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking — in words. Keep chunk_size <= 200 for all-MiniLM-L6-v2.
CHUNK_SIZE=200
CHUNK_OVERLAP=40

# Retrieval
TOP_K=5
SCORE_THRESHOLD=0.0

# Limits
MAX_UPLOAD_MB=20
SESSION_TTL_SECONDS=3600
